{
  "name": "lattice-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-assets.ts",
    "start": "node dist/backend/src/server.js",
    "worker": "node dist/backend/src/worker.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:contract": "tsx scripts/check-contract.ts",
    "format": "prettier --write src tests scripts *.json *.yaml ../src/contracts/api.ts",
    "lint": "prettier --check src tests scripts *.json *.yaml ../src/contracts/api.ts",
    "test:parser": ".venv/bin/python parser/test_parser.py"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "cheerio": "^1.1.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@electric-sql/pglite": "0.5.3",
    "@electric-sql/pglite-pgvector": "0.0.4",
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.9",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
