# Public Supabase project settings. These are intentionally safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only Next.js relay setting. Origin only; no path, credentials, query or hash.
BACKEND_API_ORIGIN=http://localhost:4000
